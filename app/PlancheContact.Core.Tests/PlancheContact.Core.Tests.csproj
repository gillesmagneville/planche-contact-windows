<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests of PlancheContact.Core, as a plain console program: no test
       framework to download, runs the same way on Linux and on Windows.
       See windows/README.md for the commands. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PlancheContact.Core.Tests</RootNamespace>
    <AssemblyName>PlancheContact.Core.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../PlancheContact.Core/PlancheContact.Core.csproj" />
  </ItemGroup>

</Project>
